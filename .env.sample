# ClickZetta Lakehouse connection — copy to .env and fill in real values
CLICKZETTA_SERVICE=<your-region>.api.clickzetta.com
CLICKZETTA_INSTANCE=<your-instance-id>
CLICKZETTA_WORKSPACE=<your-workspace>
CLICKZETTA_USERNAME=<your-username>
CLICKZETTA_PASSWORD=<your-password>
CLICKZETTA_SCHEMA=bronze
CLICKZETTA_VCLUSTER=<your-vcluster>

# Volume base path for source CSV files
MEDALLION_VOLUME_PATH=<your-volume-path>/medallion
